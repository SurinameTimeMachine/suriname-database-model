# GitHub OAuth App credentials (for place editing)
# Create at: https://github.com/settings/developers -> OAuth Apps -> New
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repository to commit gazetteer changes to
GITHUB_REPO_OWNER=SurinameTimeMachine
GITHUB_REPO_NAME=suriname-database-model
GITHUB_REPO_BRANCH=main

# Public base URL (used for OAuth callback)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (image review app /annotate) — server-side only, never commit the real password.
# Local/dev: direct connection (port 5432). Project-ref: stydnbdvuttbbzouaknv
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.stydnbdvuttbbzouaknv.supabase.co:5432/postgres

# Vercel/serverless: use the Transaction Pooler URI (port 6543) from
# Supabase Dashboard -> Connect instead of the direct URI above.

# Review task lease duration in minutes (max 240)
EVENT_TASK_LEASE_MINUTES=15
