      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Commewijne rivier\\plantages\\Dageraad Commetewane 2005-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emdndtbkNzMzRxTGc/view?usp=sharing&resourcekey=0-bfsaM172T5nIpn3Mmh0h6A",
          "author": "Philip Dikland",
          "year": "2005, aangevuld 2008",
          "notes": "De eerstbekende naam van de plantage was Castanienboom. In 1737 en 1741 werd een deel\nvan de grond verkocht aan buurplantage Nieuwsorg, en de resterende grond werd omstreeks 1750 \"Eendragt\" genoemd. Omstreeks 1840 werd deze naam gewijzigd in \"Dageraad\"."
        }
      ],
