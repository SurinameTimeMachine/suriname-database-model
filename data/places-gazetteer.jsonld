    {
      "@id": "https://data.surinametijdmachine.org/place/stm-01777",
      "@type": [
        "E25_Human-Made_Feature"
      ],
      "id": "stm-01777",
      "type": "plantation",
      "prefLabel": "Ostage",
      "altLabels": [],
      "broader": "stm-00005",
      "description": "",
      "location": {
        "lat": 5.806683644736842,
        "lng": -54.79400205105264,
        "wkt": "Polygon ((-54.79286216 5.82555455, -54.78933475 5.81846129, -54.79334348 5.81460426, -54.79630777 5.81089079, -54.79718090 5.80897500, -54.79705135 5.80695866, -54.79693380 5.80166777, -54.79544595 5.79863848, -54.79373586 5.79790959, -54.79074775 5.79836965, -54.78691490 5.80112314, -54.78302553 5.80291793, -54.78111109 5.80303107, -54.77935814 5.80190993, -54.80114790 5.78756559, -54.80217391 5.78989103, -54.81321714 5.81343702, -54.80328443 5.81952895, -54.79286216 5.82555455))",
        "crs": "EPSG:4326"
      },
      "sources": [
        "map-1930",
        "almanakken"
      ],
      "externalLinks": [
        {
          "authority": "wikidata",
          "identifier": "Q59133025",
