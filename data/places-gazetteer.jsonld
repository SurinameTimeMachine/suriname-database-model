      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Eylant en Puttenzorg 2005-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emWk8weGUxTGY5azQ/view?usp=sharing&resourcekey=0-JiHSoU-65UIViAn9SkQWCQ",
          "author": "Philip Dikland",
          "year": "2005, aangevuld 2009",
          "notes": "De plantages het Eylant en Puttenzorg hebben vanaf het begin 1 geheel gevormd. Puttenzorg \nwordt in de 19e eeuw ook wel aangeduid als “Bittenzorg”. De plantages werden na de  afschaffing van de slavernij verlaten.\n\nDe herkomst van de naam “Puttenzorg” is nog duister. Rond 1700 woonde er een familie Van\nder Putten in de Pauluskreek, mogelijk is de naam van hen afkomstig."
        }
      ]
    },
