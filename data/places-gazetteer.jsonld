      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Cottica en Perica rivier\\plantages\\Va Comme Je Te Pousse en Nouvelle Esperance 2005-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emSlQwb1VEajRpdUU/view?usp=sharing&resourcekey=0-Lm2GmzhrN5rPTHDOy3vpkw",
          "author": "Philip Dikland",
          "year": "2005",
          "notes": "Nouvelle Esperance is feitelijk het achterland van Va Comme Je Te Pousse ; vanwege de\nvreemde vorm van die plantage lag dit achterland deels aan de rivier en was het mogelijk er een zelfstandige plantage van te maken. De grens tussen Va Comme Je Te Pousse en Nouvelle\nEsperance werd gelegd bij de Cederkreek. Wanneer de afsplitsing precies is geschied, is niet\nbekend."
        },
        {
          "folderPath": "erfgoed-geschiedenis\\Cottica en Perica rivier\\plantages\\Va Comme Je Te Pousse en Nouvelle Esperance 2005-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emSlQwb1VEajRpdUU/view?usp=sharing&resourcekey=0-Lm2GmzhrN5rPTHDOy3vpkw",
          "author": "Philip Dikland",
          "year": "2005",
          "notes": "Nouvelle Esperance is feitelijk het achterland van Va Comme Je Te Pousse ; vanwege de\nvreemde vorm van die plantage lag dit achterland deels aan de rivier en was het mogelijk er een zelfstandige plantage van te maken. De grens tussen Va Comme Je Te Pousse en Nouvelle\nEsperance werd gelegd bij de Cederkreek. Wanneer de afsplitsing precies is geschied, is niet bekend."
        }
      ]
