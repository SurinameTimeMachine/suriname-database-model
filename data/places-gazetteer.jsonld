        {
          "folderPath": "erfgoed-geschiedenis\\Nickerie rivier\\plantages\\Waterloo plantation 20th century history 2021-01 Jehangir Khan.pdf",
          "driveUrl": "https://drive.google.com/file/d/1XMtaf7_2uvZzID-U1b3tpfGjQaNRosiu/view?usp=sharing",
          "author": "Jehangir Khan",
          "year": "2021",
          "notes": null
        },
        {
          "folderPath": "erfgoed-geschiedenis\\Nickerie rivier\\plantages\\Waterloo plantation 20th century history 2021-01 Jehangir Khan.pdf",
          "driveUrl": "https://drive.google.com/file/d/1XMtaf7_2uvZzID-U1b3tpfGjQaNRosiu/view?usp=sharing",
          "author": "Nehangir Khan",
          "year": "2021",
          "notes": null
        },
        {
          "folderPath": "erfgoed-geschiedenis\\Nickerie rivier\\plantages\\Waterloo 2003-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emeXhuWldibG1PSUU/view?usp=sharing&resourcekey=0-dVSNxhMk36kpx1eDxxKnVg",
          "author": "Philip Dikland",
          "year": "2003",
          "notes": "Eveneens in 1859 kwam de EBG post op de plantage tot stand. Deze post werd opgericht op\nhet verzoek van Robert Kirke. De benodigde grond werd door Kirke geschonken. De eerste\nzendeling was broeder Conrad. Omstreeks 1870 werd er een grote kerk gebouwd (bron:\nOnderweg, p. 69). De post is tot omstreeks 1960 in gebruik gebleven."
        }
      ]
    },
