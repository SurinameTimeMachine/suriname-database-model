        {
          "folderPath": "erfgoed-geschiedenis\\Commewijne rivier\\plantages\\Cannewapibo 2010-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emUFVKUGlNUXk3TXM/view?usp=sharing&resourcekey=0-o13_E4HUE5NUclc_wQLBgw",
          "author": "Philip Dikland",
          "year": "2010, aangevuld 2012",
