      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Confiance 2005-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emVkNvT1pkUDkxZVk/view?usp=sharing&resourcekey=0-_-GRx7GrjtbpIEEIryrK9g",
          "author": "Philip Dikland",
          "year": "2005",
          "notes": "De vorm van de vier plantages Santo Domingo, La Confiance, Nieuw Hazard, en Boavista,\nwijst erop dat ze gevieren ooit één grote plantage hebben gevormd. Dit blijkt echter niet uit de\narchieven.\n\nDe plantage Krommenie aan de overzijde van de rivier is de plaats van de oude hoofdstad Torarica."
        },
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Crommenie 2006-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emV2dSeWdfN0p3V2c/view?usp=sharing&resourcekey=0-bsOvFvjoYqEnK7KNs4jNJw",
          "author": "Philip Dikland",
          "year": "2006",
          "notes": "De plantage Crommenie is - volgens de Surinaamse arts en onderzoeker John de Bije \n- de locatie van de oude hoofdplaats Thorarica."
        },
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Overbrug 2004-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emdmxUVExqQXRyU2c/view?usp=sharing&resourcekey=0-_Tnh37HNZYpJNq4ZSoReaw",
          "author": "Philip Dikland",
          "year": "2004",
          "notes": null
        }
      ]
