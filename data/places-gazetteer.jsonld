    {
      "id": "stm-new-1778755884597",
      "type": "settlement",
      "names": [
        {
          "text": "Onverwacht",
          "language": "nl",
          "type": "official",
          "isPreferred": true,
          "source": "dikland-collection"
        },
        {
          "text": "Onverwagt",
          "language": "nl",
          "type": "variant",
          "isPreferred": false,
          "source": "dikland-collection"
        },
        {
          "text": "Bossee",
          "language": "nl",
          "type": "historical",
          "isPreferred": false,
          "source": "dikland-collection"
        }
      ],
      "broader": null,
      "description": "De plantage (Onverwacht / Onverwagt) was vroeger via de Para en de Hoykreek bereikbaar. Rond 1910 kwam de spoorlijn, en wat later werd vanaf het spoorstation een weg door de plantage naar Overtoom aangelegd. Na de aanleg van de spoorlijn vestigden de bewoners zich nabij het station ; het nieuwe dorpje heet “Onverwagt” of ook wel “Bossee”. De oude kampong, die vermoedelijk nabij de Para heeft gelegen, werd toen verlaten.",
      "location": {
        "lat": 5.590397,
        "lng": -55.193682,
        "wkt": null,
        "crs": "EPSG:4326"
      },
      "sources": [],
