        }
      ],
      "fid": 2260,
      "psurIds": [],
      "district": "Divisie Boven-Commewijne",
      "locationDescription": "Boven-Commewijne",
      "locationDescriptionOriginal": "Rivier Commewijne, (boven) linkerhand in het afvaren",
      "placeType": "suiker",
      "modifiedBy": null,
      "modifiedAt": null,
      "productAssertions": [],
      "statusAssertions": [],
      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Commewijne rivier\\plantages\\Ostage 2004-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emTjBwYzJmQVByQzA/view?usp=sharing&resourcekey=0-cE-3yvzRH6OLJpYV1WkuLg",
          "author": "Philip Dikland",
          "year": "2004",
          "notes": "De plantage Ostage ligt aan de linkeroever van de Commewijnerivier. Recht ertegenover ligt\nde plantage Goudmijn. Beide plantages zijn vrijwel hun gehele economische levensduur in\nhanden geweest van dezelfde eigenaar. Ostage is daarbij langzamerhand gedegradeerd van een zelfstandige suikerplantage tot een hulpgrond van plantage Goudmijn.\n\nEr was nog een derde grond die lange tijd tot het bezit behoorde ; dit is de grond  Schassenburg, later geheten Welbedacht. Deze grond ligt achter de plantages Cannewapibo en Fayerfield en voor een klein deel achter Ostage.\n\nDe grond heeft geen verbinding met de rivier. Als plantage is ze nooit van belang geweest, hoogstens is er wat hout gewerkt. Thans is deze grond een deel van Cannewapibo."
        }
      ]
    },
