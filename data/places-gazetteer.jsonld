      "locationAssertions": [],
      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Kwatta\\Stolkbuiten 2012-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emRkJ5S3JPbGtTM1E/view?usp=sharing&resourcekey=0-qC3g83sIIkrCJGI8RgpMvQ",
          "author": "Philip Dikland",
          "year": "2012",
          "notes": "Het huidige Stolkbuiten is een samenvoeging van twee oudere buitenplaatsen : Maria’s lust, en  Toevlugt.\nDe grond Maria’s Lust was 10 ketting breed. NB : De grond dient niet te worden verward met een andere grond genaamd Maria’s Rust (maar ook wel genoemd Maria’s Lust), die daarna werd hernaamd in Industrie. Dat is een andere grond. Verwarrend is het wel.\nDe grond Toevlugt heette eerst Comvaliushoop."
        }
      ]
    },
