      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Diligence 2005-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emSUFIM1dhbGZIbVU/view?usp=sharing&resourcekey=0-GXEEN3Cka4zMjfEfQfrs9Q",
          "author": "Philip Dikland",
          "year": "2005",
          "notes": "De plantage [La Diligence] had ook een klein deel aan de overzijde, tussen de rivier en de Cassipore kreek. Aan de overzijde van deze kreek is thans nog de oude joodse begraafplaats “Cassipora”. Hier schijnt ooit een eenvoudige synagoge te hebben gestaan, nog voordat de grote synagoge te Jodensavanne werd gebouwd."
        },
