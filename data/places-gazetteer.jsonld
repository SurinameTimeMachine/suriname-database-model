      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Para kreek\\plantages\\Leeuwenberg 2012-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8embGN5VVNINW55VUk/view?usp=sharing&resourcekey=0-6B_kxombUAIsmuW6YQ9gmA",
          "author": "Philip Dikland",
          "year": "2012",
          "notes": "“Leeuwenberg” is de oudste naam. Daarna werd de plantage samen met de buurgrond “Land\nvan Beaulieu” genoemd, daarna “Zwitserland”, en tenslotte duikt de oude naam “Leeuwenberg”\nweer op, terwijl de buurgrond “Zwitsersgrond” wordt genoemd."
        },
        {
          "folderPath": "erfgoed-geschiedenis\\Para kreek\\plantages\\Zwitserland 2006-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/1RBKWWu_8kUrQWa5cBpX3l7zyPBFhEacW/view?usp=sharing",
          "author": "Philip Dikland",
          "year": "2006, aangevuld 2012, 2019",
          "notes": "Zwitsersgrond en Leeuwenberg op de kaart van Bakhuys en De Quant, 1930. De kaart is onjuist ; in 1930 waren Zwitsersgrond en Leeuwenberg allang samengevoegd onder de naam “Zwitserland”."
        }
      ],
