      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Belwaarde 2003-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emVnlaQnhTQUhvSXM/view?usp=sharing&resourcekey=0-ap4lIK4i1XTaCdCCGSwikQ",
          "author": "Philip Dikland",
          "year": "2003, aangevuld 2008",
          "notes": "[De naam] schijnt oorspronkelijk “Bellewaarde” of “Bellewaard” te zijn geweest. Dat is een gehucht in het zuiden van Belgie, nabij Kortrijk. Waarom Mauricius deze naam heeft bedacht, is onbekend.\n\nBelwaarde en Clevia hebben tot omstreeks 1920 naast elkaar bestaan, daarna verdween de naam Clevia. De grond wordt thans Belwaarde genoemd."
        }
      ]
