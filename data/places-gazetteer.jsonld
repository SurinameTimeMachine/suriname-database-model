    {
      "@id": "stm:place/stm-01239",
      "@type": "E25_Human-Made_Feature",
      "id": "stm-01239",
      "type": "plantation",
      "broader": "stm-00005",
      "description": "",
      "location": {
        "lat": 5.822515144285715,
        "lng": -54.788987371428576,
        "wkt": "Polygon ((-54.78933475 5.81846129, -54.79286216 5.82555455, -54.78772310 5.82879976, -54.78717725 5.82548744, -54.78739399 5.82210055, -54.78908560 5.81874113, -54.78933475 5.81846129))",
