      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Diligence 2005-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emSUFIM1dhbGZIbVU/view?usp=sharing&resourcekey=0-GXEEN3Cka4zMjfEfQfrs9Q",
          "author": "Philip Dikland",
          "year": "2005",
          "notes": "De plantage had ook een klein deel aan de overzijde, tussen de rivier en de Cassipore kreek.\nAan de overzijde van deze kreek is thans nog de oude joodse begraafplaats “Cassipora”. Hier\nschijnt ooit een eenvoudige synagoge te hebben gestaan, nog voordat de grote synagoge te\nJodensavanne werd gebouwd."
        }
      ]
