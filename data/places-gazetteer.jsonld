      "prefLabel": "Mawakkabo",
      "altLabels": [],
      "broader": "stm-00010",
      "description": "",
      "location": {
        "lat": 5.489472135,
        "lng": -55.163383993333326,
        "wkt": "Polygon ((-55.15813156 5.49837377, -55.15715055 5.49639431, -55.15826300 5.49462782, -55.15842084 5.49088025, -55.15620913 5.48908774, -55.15448915 5.48721480, -55.15381439 5.48216319, -55.17543535 5.47522848, -55.17985165 5.47447928, -55.18477692 5.49044185, -55.16593382 5.49640036, -55.15813156 5.49837377))",
