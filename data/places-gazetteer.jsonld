      ],
      "diklandRefs": [
        {
          "folderPath": "erfgoed-geschiedenis\\Suriname rivier\\plantages\\Boavista 2007-01 geschiedenis.pdf",
          "driveUrl": "https://drive.google.com/file/d/0B88mZFitv8emSU1PeTBDUEFFYVE/view?usp=sharing&resourcekey=0-OFqu8PoCHFmngoysK5KNjw",
          "author": "Philip Dikland",
          "year": "2007, aangevuld 2010",
          "notes": "Op de kaart van Cateau van Rosevelt is duidelijk te zien dat Boavista en het naastliggende Klein Jalouzie ooit 1 geheel hebben gevormd. Het lijkt zelfs mogelijk dat Nieuw Hazard, Confiance en Santo Domingo ooit bij Boavista behoorden. De oerplantage had daarmee een logische driehoekige vorm."
        }
      ]
    },
