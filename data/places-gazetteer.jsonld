    {
      "@id": "stm:place/stm-01238",
      "@type": "E25_Human-Made_Feature",
      "id": "stm-01238",
      "type": "plantation",
      "broader": "stm-00005",
      "description": "",
      "location": {
        "lat": 5.831712636250001,
        "lng": -54.79282708375,
        "wkt": "Polygon ((-54.79286216 5.82555455, -54.79824095 5.83587504, -54.79644073 5.83706316, -54.79391869 5.83612965, -54.79192024 5.83426742, -54.78864864 5.83045696, -54.78772310 5.82879976, -54.79286216 5.82555455))",
