    {
      "@id": "stm:vocabulary/place-type/river",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "River",
        "srn": "Liba",
        "nl": "Rivier"
      },
      "definition": {
        "nl": "Een natuurlijke, permanente stroom van zoet of brak water die via een bedding naar een andere rivier, een meer of de oceaan vloeit. Binnen de Surinaamse historische context vormen de grote rivieren en hun vertakkingen de primaire infrastructurele en economische assen van het land; zij faciliteerden de transport- en exportlijnen van de kustplantages en dienden tevens als de belangrijkste navigatieroutes en leefgebieden voor Inheemse en Marrongemeenschappen in het binnenland.",
        "en": "A natural, permanent flow of fresh or brackish water that flows through a riverbed into another river, a lake or the ocean. Within the historical context of Suriname, the major rivers and their tributaries form the country’s primary infrastructural and economic arteries; they facilitated the transport and export routes of the coastal plantations and also served as the main navigation routes and habitats for Indigenous and Maroon communities in the interior."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/natural",
      "exactMatch": [
        "http://www.wikidata.org/entity/Q4022",
        "https://schema.org/RiverBodyOfWater",
        "https://vocab.getty.edu/aat/300008707"
      ],
      "typeId": "river",
      "color": "#4a88bf",
      "crmClass": "E26_Physical_Feature",
      "crmBadge": "E26",
      "sortOrder": 11,
      "created": "2026-04-07",
      "modified": "2026-06-23",
      "altLabel": {
        "en": [
          "Stream",
          "Upper Course",
          "Lower Course"
        ],
        "nl": [
          "Stroom",
          "Bovenloop",
          "Benedenloop"
        ]
      },
      "related": [
        "stm:vocabulary/place-type/creek"
      ],
      "closeMatch": [
        "http://www.wikidata.org/entity/Q355304"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/creek",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Creek",
        "nl": "Kreek",
        "srn": "Kriki"
      },
      "definition": {
        "en": "A natural, meandering watercourse that is smaller than a river and often acts as a tributary or feeder to a larger hydrographic network. Within the historical context of Suriname, creeks formed a dense network of transport routes.",
        "nl": "Een natuurlijke, stromende waterweg die kleiner is dan een rivier en dikwijls fungeert als zijtak of toevoerader van een groter hydrografisch netwerk. Binnen de Surinaamse historische context vormden kreken de fijnmazige transportroutes."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/natural",
      "closeMatch": [
        "http://www.wikidata.org/entity/Q47521"
      ],
      "typeId": "creek",
      "color": "#8dbde0",
      "crmClass": "E26_Physical_Feature",
      "crmBadge": "E26",
      "sortOrder": 12,
      "created": "2026-04-07",
      "modified": "2026-06-23",
      "altLabel": {
        "nl": [
          "zijtak",
          "spruit"
        ],
        "en": [
          "stream",
          "brook"
        ]
      },
      "related": [
