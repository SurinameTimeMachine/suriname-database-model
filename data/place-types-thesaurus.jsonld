      ]
    },
    {
      "@id": "stm:vocabulary/place-type/administrative",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Administrative Division",
        "nl": "Administratieve Indeling"
      },
      "definition": {
        "en": "A formally defined area used for governance, census, or administrative purposes."
      },
      "topConceptOf": "stm:vocabulary/place-type",
      "inScheme": "stm:vocabulary/place-type",
      "crmClass": "E53_Place",
      "crmBadge": "E53",
      "narrower": [
        "stm:vocabulary/place-type/district"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/plantation",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Plantation",
        "nl": "Plantage",
        "srn": "Plantasi"
      },
      "definition": {
        "en": "A large agricultural estate, typically established during the colonial period for the production of export crops using enslaved labor.",
        "nl": "Een groot landbouwbedrijf, doorgaans opgericht tijdens de koloniale periode voor de productie van exportgewassen met gebruik van tot slaaf gemaakte arbeid."
      },
      "editorialNote": {
        "en": "Colonial data bias: Plantations were the primary sites of enslaved labor in Suriname. The term itself carries the weight of colonial exploitation."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/human-made",
      "related": [
        "stm:vocabulary/place-type/settlement"
      ],
      "exactMatch": [
        "http://www.wikidata.org/entity/Q188913"
      ],
      "typeId": "plantation",
      "color": "#fff753",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 1,
      "created": "2026-04-07",
      "modified": "2026-06-30"
    },
    {
      "@id": "stm:vocabulary/place-type/military-post",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Military Post",
        "nl": "Militaire Post"
      },
      "altLabel": {
        "nl": [
          "voormalige militaire post (1882 map)",
          "redoute"
        ],
        "en": [
          "redoubt"
        ]
      },
      "definition": {
        "nl": "Een door de koloniale overheid opgerichte, strategisch gesitueerde versterkte positie met als doel de bescherming van de plantage-economie, de handhaving van het koloniale gezag, de surveillance van (gevluchte) tot slaaf gemaakten, en de bewaking van de territoriale grenzen.",
        "en": "A strategically situated fortified position established by the colonial authorities with the aim of protecting the plantation economy, maintaining colonial authority, monitoring enslaved people (including those who had fled), and guarding the territorial borders."
      },
      "editorialNote": {
        "nl": "Koloniaal vooroordeel: Militaire posten waren instrumenten van koloniale territoriale controle en toezicht op tot slaafgemaakte , Marron- en Inheemse gemeenschappen.",
        "en": "Colonial data bias: Military posts were instruments of colonial territorial control and surveillance of enslaved, Maroon and Indigenous communities."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/MilitaryInfrastructure",
      "related": [
        "stm:vocabulary/place-type/settlement",
        "stm:vocabulary/place-type/plantation"
      ],
      "closeMatch": [
        "http://www.wikidata.org/entity/Q245016",
        "http://www.wikidata.org/entity/Q1321241",
        "https://schema.org/DefenceEstablishment"
      ],
      "typeId": "military-post",
      "color": "#c98763",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 2,
      "created": "2026-04-07",
      "modified": "2026-06-23"
    },
    {
      "@id": "stm:vocabulary/place-type/transport-infrastructure",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Transport Infrastructure",
        "nl": "Transportinfrastructuur"
      },
      "definition": {
        "nl": "Het geheel van permanente fysieke netwerken dat transport en verplaatsing van personen en goederen faciliteert binnen Suriname. Dit omvat zowel de natuurlijke en infrastructureel aangepaste waterwegen (rivieren, kanalen, kreken, sluizen) als landinfrastructuur (spoorwegen, (koloniale) paden, wegen, bruggen en overslagpunten).",
        "en": "The network of permanent physical infrastructure that facilitates the transport and movement of people and goods within Suriname. This includes both natural and infrastructure-enhanced waterways (rivers, canals, creeks, locks) and land-based infrastructure (railways, (colonial) tracks, roads, bridges and transhipment points)."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/human-made",
      "narrower": [
        "stm:vocabulary/place-type/road",
        "stm:vocabulary/place-type/railroad"
      ],
      "typeId": "transport-infrastructure",
      "color": "#529e6c",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 3,
      "created": "2026-04-21",
      "modified": "2026-07-06",
      "related": [
        "stm:vocabulary/place-type/road",
        "stm:vocabulary/place-type/railroad",
        "stm:vocabulary/place-type/river",
        "stm:vocabulary/place-type/creek"
      ],
      "exactMatch": [
        "http://www.wikidata.org/entity/Q376799"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/road",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Road",
        "nl": "Weg",
        "srn": "Pasi"
      },
      "altLabel": {
        "en": [
          "Street",
          "Path",
          "Trail"
        ],
        "nl": [
          "Straat",
          "Pad",
          "Spoor"
        ]
      },
      "definition": {
        "en": "A constructed path or route for transportation between settlements.",
        "nl": "Een herkenbare of functionele landroute (verhard, onverhard of overgroeid) die is aangelegd of ontstaan ten behoeve van de verplaatsing van personen, dieren of goederen. Binnen de Surinaamse historische context omvat dit zowel de formele koloniale infrastructuur (stedelijke straten, interdistrictswegen, militaire paden en plantagedammen) als de informele, dikwijls niet-gekaarte paden en vluchtroutes die door Inheemsen, Marrons en tot slaaf gemaakten werden gebruikt voor navigatie, handel en verzet in het binnenland."
      },
      "editorialNote": {
        "nl": "Stedelijke straten worden momenteel onder weg genormaliseerd omdat de beschikbare brondata geen stabiel onderscheid tussen weg en straat ondersteunen.",
        "en": "A distinct or functional overland route (paved, unpaved, or overgrown) constructed or naturally formed for the movement of people, animals, or goods. Within the historical context of Suriname, this encompasses both formal colonial infrastructure (urban streets, inter-district roads, military trails, and plantation dikes) as well as the informal, often unmapped paths and escape routes utilized by Indigenous peoples, Maroons, and enslaved individuals for navigation, trade, and resistance in the interior."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/transport-infrastructure",
      "exactMatch": [
        "http://www.wikidata.org/entity/Q34442"
      ],
      "typeId": "road",
      "color": "#2cfb06",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 4,
      "created": "2026-04-07",
      "modified": "2026-06-30",
      "related": [
        "stm:vocabulary/place-type/railroad"
      ],
      "closeMatch": [
        "https://vocab.getty.edu/aat/300008321",
        "https://wiki.openstreetmap.org/wiki/Key:highway"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/railroad",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Railroad",
        "nl": "Spoorweg"
      },
      "definition": {
        "nl": "Een transportroute over land die is uitgerust met vaste metalen spoorstaven (rails) ten behoeve van de geleide voortbeweging van treinen of lorries. Binnen de Surinaamse historische context omvat dit zowel de door de overheid aangelegde infrastructuur voor personen- en vrachtvervoer naar het binnenland (zoals de Lawaspoorweg) als de private (smal)spoorlijnen op plantages en mijnbouwterreinen voor het transport van landbouwproducten en ertsen.",
        "en": "An overland transport route equipped with permanent metal rails designed to guide and support the movement of trains or locotractors/lorries. Within the historical context of Suriname, this encompasses both state-built infrastructure for passenger and freight transit into the interior (such as the Lawa Railway) and private (narrow-gauge) rail lines used on plantations and mining sites to transport agricultural products and ores."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/transport-infrastructure",
      "closeMatch": [
        "http://www.wikidata.org/entity/Q22667"
      ],
      "typeId": "railroad",
      "color": "#0fd09b",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 5,
      "created": "2026-04-07",
      "modified": "2026-06-30"
    },
    {
      "@id": "stm:vocabulary/place-type/station",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Geodetic control point",
        "nl": "Geodetisch referentiepunt"
      },
      "definition": {
        "srn": "Lanti-marki [?]",
        "nl": "Een specifiek, fysiek vastgelegd meetpunt in het terrein dat door landmeters en cartografen is gebruikt voor astronomische plaatsbepaling (het bepalen van de exacte geografische coördinaten aan de hand van hemellichamen). Binnen de context van de historische cartografie van Suriname—in het bijzonder de topografische kaart van 1930—dienden deze astronomische stations als de primaire, hoogst nauwkeurige referentiepunten (ankerpunten) om het omringende rivier- en boslandschap cartografisch te positioneren.",
        "en": "A specific, physically established geodetic control point used by surveyors and cartographers for astronomical positioning (determining precise geographic coordinates by observing celestial bodies). Within the context of historical Surinamese cartography—specifically the 1930 topographical map—these astronomical stations served as the primary, highly accurate reference anchors used to mathematically align and map the surrounding river networks and dense interior terrain."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/human-made",
      "closeMatch": [
        "http://www.wikidata.org/entity/Q131862"
      ],
      "typeId": "station",
      "color": "#afafa7",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 6,
      "created": "2026-04-07",
      "modified": "2026-06-30",
      "altLabel": {
        "nl": [
          "Astronomisch meetpunt",
          "Geodetisch referentiepunt",
          "Observatiestation",
          "Astronomisch Station"
        ],
        "en": [
          "Astronomical observation point",
          "Geodetic control point",
          "Surveying station",
          "Astronomical Station"
        ],
        "srn": [
          "Stasi"
        ]
      },
      "exactMatch": [
        "http://www.wikidata.org/entity/Q111340425"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/settlement",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Settlement",
        "nl": "Nederzetting",
        "srn": "Kondre"
      },
      "altLabel": {
        "nl": [
          "Leprozen etablissement",
          "strafetablissement",
          "nederzetting",
          "dorp",
          "woonplaats",
          "kamp",
          "plantage"
        ],
        "en": [
          "Leper colony",
          "penal colony",
          "settlement",
          "village",
          "place of residence",
          "camp",
          "plantation"
        ]
      },
      "definition": {
        "nl": "Een plaats of geografisch afgebakend gebied waar menselijke bewoning plaatsvindt of heeft plaatsgevonden, variërend van tijdelijke kampementen tot permanente dorpen en steden. Binnen de Surinaamse historische context omvat dit een diverse typologie van gemeenschappen, waaronder inheemse dorpen, marrondorpen (of weglopersnederzettingen in het binnenland), plantagewoningen, militaire posten, goudzoekers- of balatablederskampen, en de formele koloniale vestigingen in de kustvlakte en districten.",
        "en": "A locality or geographically defined area of past or present human habitation, ranging from temporary encampments to permanent villages and urban centers. Within the historical context of Suriname, this encompasses a highly diverse typology of communities, including indigenous villages, Maroon settlements (historically established in the interior as sites of resistance), plantation villages, military outposts, gold-mining or balata-bleeding camps, and formal colonial towns across the coastal plains and districts."
      },
      "editorialNote": {
        "en": "Colonial data bias: Several settlements have colonial institutional origins (leper colonies, penal establishments, government provisions grounds) reflecting colonial governance structures.",
        "nl": "Koloniaal vooroordeel: Diverse nederzettingen hebben koloniale institutionele oorsprong (leprozenkolonies, strafgestichten, gouvernements kostgronden) die koloniale bestuursstructuren weerspiegelen."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/human-made",
      "related": [
        "stm:vocabulary/place-type/plantation",
        "stm:vocabulary/place-type/military-post",
        "stm:vocabulary/place-type/indigenous-village",
        "stm:vocabulary/place-type/town",
        "stm:vocabulary/place-type/maroon-village"
      ],
      "exactMatch": [
        "http://www.wikidata.org/entity/Q486972"
      ],
      "narrower": [
        "stm:vocabulary/place-type/town",
        "stm:vocabulary/place-type/indigenous-village",
        "stm:vocabulary/place-type/maroon-village"
      ],
      "typeId": "settlement",
      "color": "#cf8860",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 7,
      "created": "2026-04-07",
      "modified": "2026-06-23",
      "closeMatch": [
        "http://www.wikidata.org/entity/Q22674925",
        "https://vocab.getty.edu/aat/300008347",
        "https://lod.enslaved.org/wiki/Q194"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/town",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Town",
        "nl": "Stad",
        "srn": "Foto"
      },
      "definition": {
        "nl": "Een grotere, permanente en compact gebouwde menselijke nederzetting met een zekere mate van centrale administratieve, economische en maatschappelijke infrastructuur. Binnen de Surinaamse historische context verwijst dit primair naar de hoofdstad Paramaribo en de secundaire districtskernen zoals Nieuw-Nickerie, Albina en Totness die fungeerden als de lokale knooppunten van het koloniale bestuur, de handel en de rechtspraak.",
        "en": "A larger, permanent and compactly built human settlement with a certain degree of central administrative, economic and social infrastructure. Within the historical context of Suriname, this refers primarily to the capital, Paramaribo, and the secondary district centres such as Nieuw-Nickerie, Albina and Totness, which served as local hubs for colonial administration, trade and the administration of justice."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/settlement",
      "exactMatch": [
        "http://www.wikidata.org/entity/Q3957",
        "https://vocab.getty.edu/aat/300008375"
      ],
      "typeId": "town",
      "color": "#d4a074",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 8,
      "created": "2026-04-07",
      "modified": "2026-06-23",
      "altLabel": {
        "nl": [
          "vlek",
          "hoofdplaats",
          "districtskern"
        ],
        "en": [
          "urban area"
        ]
      },
      "related": [
        "stm:vocabulary/place-type/settlement",
        "stm:vocabulary/place-type/maroon-village",
        "stm:vocabulary/place-type/indigenous-village"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/indigenous-village",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Indigenous Village",
        "nl": "Inheems Dorp"
      },
      "altLabel": {
        "nl": [
          "Indiaansch dorp",
          "Indianen (kaart 1882)",
          "I (kaart 1930)"
        ],
        "en": [
          "Native American village",
          "Native Americans (map 1882)",
          "I (map 1930)"
        ]
      },
      "definition": {
        "nl": "Een permanente of semi-permanente menselijke nederzetting gesticht en bewoond door de oorspronkelijke, inheemse bevolking van Suriname (zoals de Lokono, Kaliña, Trio of Wayana). ",
        "en": "A permanent or semi-permanent human settlement founded and inhabited by the original, indigenous peoples of Suriname (such as the Lokono, Kaliña, Trio or Wayana)."
      },
      "editorialNote": {
        "en": "Colonial prejudice: ‘Indian village’ (abbreviated to ‘I’ on the map) are colonial terms. Indigenous communities were reduced to single-letter codes.",
        "nl": "Koloniaal vooroordeel: \"Indiaansch dorp\" (afgekort tot “I” op de kaart) zijn koloniale termen. Inheemse gemeenschappen werden gereduceerd tot codes van een enkele letter."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/settlement",
      "typeId": "indigenous-village",
      "color": "#e8ad80",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 9,
      "created": "2026-04-07",
      "modified": "2026-06-23",
      "related": [
        "stm:vocabulary/place-type/town",
