    {
      "@id": "stm:vocabulary/place-type/maroon-village",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "Maroon Village",
        "nl": "Marrondorp",
        "srn": "Marunkondre"
      },
      "altLabel": {
        "nl": [
          "Boschdorp",
          "Boschnegerdorp",
          "Boschnegers",
          "“B” (afkorting kaart 1930)"
        ],
        "en": [
          "Forest village",
          "Bush negro village",
          "“B”  (1930 map code)"
        ]
      },
      "definition": {
        "en": "A permanent or semi-permanent human settlement in the interior of Suriname, founded and inhabited by Maroons (escaped enslaved people and their descendants).",
        "nl": "Een permanente of semi-permanente menselijke nederzetting in het binnenland van Suriname, gesticht en bewoond door Marrons (gevluchte tot slaaf gemaakten en hun nakomelingen)."
      },
      "editorialNote": {
        "en": "Colonial data bias: \"Boschnegers\" (lit. \"bush negroes\") was a derogatory Dutch colonial designation for Maroon communities.",
        "nl": "Koloniaal vooroordeel: \"Boschnegers\" was een denigrerende Nederlandse koloniale aanduiding voor Marrongemeenschappen."
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/settlement",
      "closeMatch": [
        "http://www.wikidata.org/entity/Q445485",
        "http://www.wikidata.org/entity/Q1415423"
      ],
      "typeId": "maroon-village",
      "color": "#d09070",
      "crmClass": "E25_Human-Made_Feature",
      "crmBadge": "E25",
      "sortOrder": 10,
      "created": "2026-04-07",
      "modified": "2026-06-23",
      "related": [
        "stm:vocabulary/place-type/indigenous-village",
        "stm:vocabulary/place-type/settlement",
        "stm:vocabulary/place-type/town"
      ]
