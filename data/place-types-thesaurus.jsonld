      ],
      "exactMatch": [
        "http://www.wikidata.org/entity/Q2043393",
        "https://vocab.getty.edu/aat/300008706"
      ]
    },
    {
      "@id": "stm:vocabulary/place-type/district",
      "@type": [
        "skos:Concept",
        "crm:E55_Type"
      ],
      "prefLabel": {
        "en": "District",
        "nl": "District",
        "srn": "Distrikt"
      },
      "definition": {
        "en": "A defined geographical and administrative area that constituted the lowest level of the national administration in Suriname (outside the city of Paramaribo). Led by a district commissioner, the districts functioned as local units for administration, policing and the administration of justice. ",
        "nl": "Een afgebakend geografisch en bestuurlijk gebied dat de bestuurlijk laag vormde van het landsbestuur in Suriname (buiten de stad Paramaribo). Geleid door een districtscommissaris fungeerden de districten als lokale eenheden voor bestuur, politie en rechtspraak. "
      },
      "inScheme": "stm:vocabulary/place-type",
      "broader": "stm:vocabulary/place-type/administrative",
      "exactMatch": [
        "http://www.wikidata.org/entity/Q149621"
